{
    "compilerOptions": {
        "target": "ES2022",
        "module": "esnext",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "outDir": "./dist",
        "moduleResolution": "node",
        "resolveJsonModule": true, // This enables JSON imports
    },
    "include": ["src"]
}
